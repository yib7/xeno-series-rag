# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
dist/
build/

# Project data: pulled or derived artifacts, never committed
data/raw/
data/vectorstore/
# Pre-reconstruction store snapshot from the v1.3.1 g_<game> flag fix (undo path); local-only,
# safe to delete now that v1.3.1 shipped.
data/vectorstore_backup_cycle6/
data/processed/
# pipeline stage files and the eval harness's per-question run logs
*.jsonl

# Server / pipeline logs
*.log

# Per-game brand art: copyrighted logos and box art, fetched locally (scripts/fetch_art.py),
# not committed. The UI degrades to styled text wordmarks when absent.
xeno_rag/web/static/art/*.png
xeno_rag/web/static/art/*.jpg
xeno_rag/web/static/art/*.jpeg
xeno_rag/web/static/art/*.webp

# Maintainer's local build-planning scratch directory; never published
.autopilot/

# Secrets: .env holds the API keys (.env.example is the committed template); *.key is a backstop
.env
*.key

# Editor and OS litter from contributors' machines
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
