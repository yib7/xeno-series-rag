# Copy this file to .env and fill in your key. .env is gitignored and must never be committed.
#
# Gemini API key: required only for generating live answers (retrieval works without it).
# Create one at https://aistudio.google.com/apikey
# Either variable name is accepted; GOOGLE_API_KEY is checked first, then GEMINI_API_KEY.
GEMINI_API_KEY=your-gemini-api-key-here

# Trust the X-Forwarded-For header for per-client rate limiting. Leave unset (off) for a
# directly-exposed or localhost deployment: the header is client-spoofable and trusting it would let
# a caller mint a fresh rate-limit bucket per request. Set to 1 only when this process sits behind a
# reverse proxy (nginx / Cloudflare / etc.) that sets XFF itself and is the sole path in.
# XENO_TRUST_PROXY=1

# Warm the heavy retrieval singletons (Qwen embedder ~1.2GB, reranker, ChromaDB, BM25) at server
# startup instead of inside the first question. Off by default so dev restarts stay fast; set to 1
# for a long-running deployment where a slow boot beats a slow first answer.
# XENO_WARM=1

# Jev (TypeSafe AI) API key: optional. Jev is the "decision model" that auto-routes each question
# to an answer tier (fast / thinking / scholar) before retrieval. Without this key, every question
# uses the configured fallback tier (see router.fallback_tier in config.yaml) instead of being
# routed, and answering still works normally. Create a key at https://docs.typesafe.ai.
# TYPESAFE_API_KEY=your-typesafe-api-key-here
